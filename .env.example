# Database (cho cả Next.js API routes và Python backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/narrative_health

# Test Database (isolated environment for integration tests)
# IMPORTANT: This must NOT point to production database
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/narrative_health_test

# Frontend API URL (chỉ dùng trong development)
# - Dev: http://localhost:8000 (gọi đến FastAPI)
# - Prod: để trống (same origin)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Python Backend Settings
APP_ENV=development
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# ==============================================================================
# LLM Provider Configuration Template (.env)
# ==============================================================================
# Copy this file to `.env` in your project root and update with your own keys.
# NEVER commit your actual `.env` file to version control!
# ==============================================================================

LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDER
# ------------------------------------------------------------------------------
# Default provider uses OpenAI or any OpenAI-compatible API endpoint.

OPENAI_API_KEY=gsk_your-groq-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=qwen/qwen3.8-27b

# ── FALLBACK 1 (hcnsec) ──
FALLBACK_OPENAI_API_KEY=your-hcnsec-api-key
FALLBACK_OPENAI_BASE_URL=https://api.hcnsec.cn/v1
FALLBACK_MODEL_NAME=Qwen3.8-27B

# ── FALLBACK 2 (OpenRouter) ──
FALLBACK2_OPENAI_API_KEY=sk-or-v1-your-openrouter-key
FALLBACK2_OPENAI_BASE_URL=https://openrouter.ai/api/v1
FALLBACK2_MODEL_NAME=openrouter/free

# ------------------------------------------------------------------------------
# 4. OTHER POPULAR NATIVE PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Anthropic Claude:
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# Google Gemini:
# GOOGLE_API_KEY=AIzaSy...

