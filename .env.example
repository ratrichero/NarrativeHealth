# Database (cho cả Next.js API routes và Python backend)
# Máy dev: trỏ DB dev trên loopback (tên chứa dev/test/local). Production dùng
# DATABASE_URL riêng trên VPS — không bao giờ đặt DB production trong file này.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/narrative_health_dev

# Test Database (isolated environment for integration tests)
# IMPORTANT: This must NOT point to production database
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/narrative_health_test

# Frontend API URL (chỉ dùng trong development)
# - Dev: http://localhost:8000 (gọi đến FastAPI)
# - Prod: để trống (same origin)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Python Backend Settings
APP_ENV=development
LOG_LEVEL=INFO

# ENV-GUARD-01 — publish/scheduler/write chỉ chạy ở production thật.
# Danh sách hostname (phân tách bằng dấu phẩy) được phép ghi DB và publish;
# để trống = read-only (fail-closed). Hỗ trợ wildcard `*.domain.tld`.
# Loopback (localhost/127.x/::1) chỉ được chấp nhận khi NODE_ENV=production
# (next start) — `next dev` luôn bị chặn, kể cả khi APP_ENV=production.
#
# Máy dev (APP_ENV=development): `write`/`scheduler` được phép — refresh chạy
# bình thường — nhưng CHỈ khi DATABASE_URL trỏ DB dev/test trên loopback
# (localhost/127.x/::1 + tên DB chứa dev/test/local). Trỏ DB production từ xa =
# vẫn read-only (403). `publish` ra Binance Square luôn cần production thật.
PRODUCTION_ALLOWED_HOSTS=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# ==============================================================================
# LLM Provider Configuration Template (.env)
# ==============================================================================
# Copy this file to `.env` in your project root and update with your own keys.
# NEVER commit your actual `.env` file to version control!
# ==============================================================================

# ── LLM tuning (read by src/lib/llm/config.ts, shared by the Square content
# ── chain AND chat). Everything is clamped: attempts 1–4, timeout 5–120s,
# ── temperature 0–1.5, so a typo cannot stall the pipeline.
#
# LLM_MAX_RETRIES: extra attempts after a transient 429/503 for the same key.
#   HTTP attempts = 1 + this value, hard cap 4. Unset = 3 attempts (= 2 here).
#   Do NOT raise this to "be safe": the provider chain already tries google →
#   primary → fallback1 → fallback2, so 6 just makes one more call per tier
#   (and is capped at 4 attempts anyway).
LLM_MAX_RETRIES=2
#
# LLM_REQUEST_TIMEOUT: seconds per request. Streamed chat answers keep a 60s
#   floor, so lowering this cannot truncate them mid-sentence.
LLM_REQUEST_TIMEOUT=30.0
#
# LLM_TEMPERATURE: leave UNSET unless you intend to change every consumer.
#   When set it overrides the per-call defaults (chat 0.4, Square posts 0.3).
#   A high value such as 0.6 makes setup posts miss their format checks
#   (cashtag, %, disclaimer) and fall back to templates, and changes the chat
#   assistant's tone — that is why this line is commented out.
# LLM_TEMPERATURE=0.3

# LLM_CONFIG_SECRET: encrypts provider API keys saved from Admin → LLM
#   Providers (app_settings.llm.chain). Falls back to AUTH_SECRET when unset.
#   Rotating it makes already-stored keys unreadable — re-enter them in the
#   admin panel. Generate with: openssl rand -base64 32
LLM_CONFIG_SECRET=

# LLM_FORCE_ENV=1 → bỏ qua cấu hình LLM trong DB và dùng .env (kill switch khi
# cấu hình DB làm chat/pipeline sập). Cần restart để có hiệu lực.
# LLM_FORCE_ENV=0

# LLM-OPS-01 knobs (all optional):
# LLM_KEY_TOKENS_PER_MIN: bỏ qua key đã dùng hết ngân sách token/phút này
#   (mặc định 12000). Dùng usage.total_tokens của provider.
# LLM_CONTEXT_TOKENS: ngân sách token cho history chat (mặc định 6000, ~4 ký tự/token).
# LLM_TOOL_CALLS_PER_MIN: trần số lần mỗi tool/phút (mặc định 30).
# LLM_CANARY_ENABLED=0: tắt probe 1-token mỗi tier mỗi 5 phút (instrumentation).
# EVAL_MIN_PASS_RATE: ngưỡng pass của `npm run eval:llm` (mặc định 0.75).
# LLM_KEY_TOKENS_PER_MIN=12000
# LLM_CONTEXT_TOKENS=6000
# LLM_TOOL_CALLS_PER_MIN=30
# LLM_CANARY_ENABLED=1
# EVAL_MIN_PASS_RATE=0.75

# Canary tuning (LLM-CANARY-02). Mặc định canary dùng đúng ngân sách của traffic
# thật (LLM_REQUEST_TIMEOUT) thay vì 10s cứng, retry 1 lần trước khi tính miss,
# và chỉ coi tier là fail sau 2 lượt liên tiếp.
# LLM_CANARY_TIMEOUT_MS=30000   # 0/unset = dùng LLM_REQUEST_TIMEOUT
# LLM_CANARY_RETRY_DELAY_MS=1500
# LLM_CANARY_STAGGER_MS=300     # nghỉ giữa các tier để không bắn burst
# LLM_CANARY_SKIP=fallback2     # tier free quota thấp: bỏ khỏi probe, lấy health từ traffic thật
# LLM_CANARY_PREFLIGHT=1        # kiểm tra GET /models trước khi tốn 1 token (opt-in)

# LLM-OPS-05 knobs (all optional):
# LLM_HEDGE_MS: chat chờ tier đầu bao lâu (ms) trước khi chạy song song tier kế.
#   MẶC ĐỊNH TẮT (unset/0): hedge có thể nhân đôi call và chi phí của một lượt
#   khi tier đầu chậm, nên chỉ bật khi thật sự cần cắt tail latency. Chỉ chat.
# LLM_BREAKER_COOLDOWN_MS: thời gian bỏ qua tier sau 2 lỗi provider liên tiếp
#   (mặc định 300000 = 5 phút). LLM_BREAKER_AUTH_COOLDOWN_MS cho lỗi 401/403
#   (mặc định 1800000 = 30 phút). Breaker lưu ở app_settings nên sống qua restart.
# LLM_DAILY_BUDGET_USD: ngưỡng CẢNH BÁO chi phí ước tính/ngày (0/unset = tắt).
#   Vượt ngưỡng chỉ hiện cảnh báo trong admin — không chặn chat hay pipeline.
#   Số USD là ước tính theo instance, không phải hoá đơn.
# LLM_COST_INPUT_SHARE: tỉ lệ token input khi ước tính USD (mặc định 0.7).
# LLM_SQUARE_JSON=1: yêu cầu Square trả JSON {"post": "..."} khi model hỗ trợ.
# CHAT_TURNS_PER_DAY / CHAT_TOKENS_PER_DAY: hạn mức mỗi session chat/ngày
#   (mặc định 80 lượt / 150000 token). CHAT_QUOTA_SOFT_PCT=80: ngưỡng bắt đầu
#   trả lời ngắn + tắt tool trước khi từ chối hẳn.
# LLM_GROUNDING_REPAIR=1: bật lượt sửa tự động khi câu trả lời có ≥2 số không
#   truy được về tool (số model tự tính từ tool được chấp nhận, không tính).
#   Mặc định TẮT để không tốn thêm 1 completion mỗi lượt; khi bật vẫn giới hạn
#   1 lần / LLM_GROUNDING_REPAIR_INTERVAL_MS (mặc định 600000 = 10 phút).
# LLM_PERSIST=0: script (eval, chẩn đoán) không ghi telemetry/trace/breaker/cost
#   vào DATABASE_URL trong .env. Test luôn tắt persistence.
# LLM_BREAKER_TEST=1: chỉ dùng trong test để bật lại gate breaker ở chain builder.
# LLM_HEDGE_MS=2500
# LLM_BREAKER_COOLDOWN_MS=300000
# LLM_BREAKER_AUTH_COOLDOWN_MS=1800000
# LLM_DAILY_BUDGET_USD=0
# LLM_COST_INPUT_SHARE=0.7
# LLM_SQUARE_JSON=0
# CHAT_TURNS_PER_DAY=80
# CHAT_TOKENS_PER_DAY=150000
# CHAT_QUOTA_SOFT_PCT=80

# ------------------------------------------------------------------------------
# 0. GOOGLE AI TIER — tried FIRST in the chain (google → primary → fallback1/2)
# ------------------------------------------------------------------------------
# A pool of Google AI Studio keys, comma-separated. A 429/500 on one key flows
# to the next key before the tier is abandoned; a key that keeps failing gets a
# cooldown, and it is reported back to the LLM Monitor. Leave both lines
# commented out to run without the google tier at all.
#
# GOOGLE_AI_MODEL_NAME: any Gemini model exposed by the OpenAI-compatible
#   endpoint (streaming + tool calls are used by chat).
# A single key works too: GOOGLE_AI_API_KEY (same pool, one entry).
# GOOGLE_AI_API_KEYS=AIza-your-key-1,AIza-your-key-2
# GOOGLE_AI_MODEL_NAME=gemini-3.5-flash-lite
#
# Cooldown after a failing key (ms): default 60s for 429/5xx, 10 min for
# 401/403 so a suspended or revoked key is not retried on every request.
# GOOGLE_AI_KEY_COOLDOWN_MS=60000
# GOOGLE_AI_KEY_AUTH_COOLDOWN_MS=600000

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDER
# ------------------------------------------------------------------------------
# Default provider uses OpenAI or any OpenAI-compatible API endpoint.

OPENAI_API_KEY=gsk_your-groq-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=qwen/qwen3.8-27b

# ── FALLBACK 1 (hcnsec) ──
FALLBACK_OPENAI_API_KEY=your-hcnsec-api-key
FALLBACK_OPENAI_BASE_URL=https://api.hcnsec.cn/v1
FALLBACK_MODEL_NAME=Qwen3.8-27B

# ── FALLBACK 2 (OpenRouter) ──
FALLBACK2_OPENAI_API_KEY=sk-or-v1-your-openrouter-key
FALLBACK2_OPENAI_BASE_URL=https://openrouter.ai/api/v1
FALLBACK2_MODEL_NAME=openrouter/free

# ------------------------------------------------------------------------------
# 4. OTHER POPULAR NATIVE PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Anthropic Claude:
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# Google Gemini:
# GOOGLE_API_KEY=AIzaSy...


# ── MARKET RADAR (RADAR-01) ──
# Volume 24h tối thiểu (USD) để một symbol vào universe radar.
RADAR_MIN_VOLUME_USD=10000000
# Số coin enrich sâu mỗi bên (5–15). Tăng = chậm hơn, nhiều weight Binance hơn.
RADAR_ENRICH_PER_SIDE=10
# Số candidate cho tab Radar sớm (6–20).
RADAR_UNUSUAL_CANDIDATES=12
# Đặt 0 để tắt nút AI brief (LLM vẫn dùng chain hiện có khi bật).
RADAR_LLM_ENABLED=1
# CHỈ dùng để xem UI khi server bị Binance geo-block (HTTP 451). Mặc định tắt.
RADAR_DEMO=0

# RADAR-02 — rate limit & quota (per instance, in-memory sliding window)
RADAR_LIST_PER_IP_PER_MIN=30
RADAR_TRACK_RECORD_PER_IP_PER_MIN=15
RADAR_BRIEF_PER_IP_PER_HOUR=10
# Trần brief/ngày toàn hệ thống, lưu app_settings (0 = không giới hạn).
RADAR_BRIEF_DAILY_LIMIT=200
# RADAR-02: chỉ bật 1 nếu proxy của bạn chỉ set X-Forwarded-For (lấy hop phải nhất).
RADAR_TRUST_XFF=0

# RADAR-CONFIG — Các biến RADAR_*/CATALYST_* bên dưới chỉ là FALLBACK.
# Admin → Vận hành → "Radar & Catalyst" lưu cấu hình vào app_settings (`radar.config`),
# ưu tiên hơn env và áp dụng ngay (cache 10 giây + invalidate sau khi lưu), không cần restart.
# Field chưa lưu trong DB sẽ lấy env ở đây; không set env thì dùng default trong
# src/lib/settings/radar-config.ts.

# RADAR-03 — alert webhook (generic JSON có `text`) và ngưỡng gửi.
# Để trống = tắt alert. Dedupe symbol+bias+ngày, lưu app_settings.
RADAR_ALERT_WEBHOOK_URL=
RADAR_ALERT_MIN_SCORE=75
RADAR_ALERT_MIN_ENTRY=50
RADAR_ALERT_MAX_IMPULSE_HOURS=12
RADAR_ALERT_COOLDOWN_HOURS=6

# RADAR-03 — universe quét cluster cố định, độc lập tab.
# Chỉ fetch 30 nến 1h/coin, cache 5 phút; 0 = tắt.
RADAR_CLUSTER_UNIVERSE=32

# Correlation residual sau khi bỏ beta BTC; cap chặn siêu cụm.
RADAR_CLUSTER_THRESHOLD=0.6
RADAR_CLUSTER_MAX_SIZE=8

# RADAR-06 — catalyst layer (“vì sao volume bất thường”).
# Alert radar (RADAR-03) tự kèm 1–3 fact khi row catalystTriggered đạt ngưỡng,
# dùng RADAR_ALERT_WEBHOOK_URL/cooldown/dedupe ở trên; không có env riêng.
# Panel chỉ hiện khi volumeZ >= ngưỡng HOẶC volume 7d ratio >= ngưỡng
# HOẶC |change 24h| >= ngưỡng (owner chốt thêm ngưỡng change 18/11).
CATALYST_TRIGGER_VOLUME_Z=2
CATALYST_TRIGGER_VOLUME_RATIO=2.2
CATALYST_TRIGGER_ABS_CHANGE_PCT=10
# 0 = chỉ template facts, không gọi LLM. LLM chỉ tóm tắt facts, không suy đoán.
CATALYST_LLM_ENABLED=1
# Trần số lượt gọi LLM tóm tắt catalyst mỗi ngày (UTC), lưu app_settings
# (`catalyst.llm.usage`). Vượt trần → template facts, không gọi provider.
# 0 = không giới hạn. Đây là lớp chặn chi phí duy nhất ngoài cache 30 phút.
CATALYST_LLM_DAILY_LIMIT=200
# Rate limit endpoint /api/market/movers/[symbol]/catalysts theo IP.
CATALYST_PER_IP_PER_MIN=20

# RADAR-06-SCHED — nhịp sync catalyst (FastAPI APScheduler → POST /api/catalyst/sync).
# Chỉ là FALLBACK: Admin → Vận hành → Radar & Catalyst lưu nhịp vào
# app_settings.radar.config; FastAPI đọc lại DB mỗi 30 giây và tự reschedule.
# Announcement Binance cần tươi (5–10 phút); RSS 10–15 phút là đủ; unlock chỉ đọc
# event_risks (đổi 1 lần/ngày) nên 60 phút. Đặt 0 để tắt riêng từng job.
SCHEDULER_CATALYST_ENABLED=true
SCHEDULER_CATALYST_ANNOUNCEMENTS_MINUTES=5
SCHEDULER_CATALYST_NEWS_MINUTES=15
SCHEDULER_CATALYST_UNLOCKS_MINUTES=60
SCHEDULER_CATALYST_TIMEOUT=180
# Token chung (Next đọc SCHEDULER_CATALYST_TOKEN, FastAPI đọc
# scheduler_catalyst_token từ cùng .env). Để trống = không đòi token.
# Token KHÔNG đưa vào form Admin (bí mật) — chỉ đổi qua env + restart.
SCHEDULER_CATALYST_TOKEN=

# RADAR-COHORT — cohort/ledger/alert (và webhook alert) chạy bằng job FastAPI
# gọi POST /api/market/radar/cohort, KHÔNG còn chạy trong after() của request
# radar: tải không phụ thuộc số người mở /radar và không nhân lên theo số
# instance (endpoint giành khoá trong app_settings). 0 = tắt job; nhịp thực tế
# tối thiểu 10 phút. Endpoint dùng chung SCHEDULER_CATALYST_TOKEN.
# Nhịp runtime ưu tiên app_settings.radar.config.schedulerCohortMinutes
# (Admin → Vận hành → Radar & Catalyst); env chỉ là fallback.
SCHEDULER_RADAR_COHORT_MINUTES=30
SCHEDULER_RADAR_COHORT_TIMEOUT=300

# RADAR-BIAS-LOG — job FastAPI gọi POST /api/market/radar/bias-outcomes để tính
# outcome 1h/4h/24h/3d/7d cho các row trong bảng radar_bias_log do job cohort
# ghi. 0 = tắt job; insert idempotent theo (log_id, horizon) nên chạy trùng an
# toàn. Endpoint dùng chung SCHEDULER_CATALYST_TOKEN. Nhịp runtime ưu tiên
# app_settings.radar.config.schedulerBiasOutcomeMinutes; env chỉ là fallback.
SCHEDULER_RADAR_BIAS_OUTCOME_MINUTES=10
SCHEDULER_RADAR_BIAS_OUTCOME_TIMEOUT=300

# RADAR-06-STALE — feed chết âm thầm: STALE khi quá hạn 2.5 nhịp của scope
# (announcement/RSS/unlock ở trên) HOẶC 2 lượt liền fetch thành công mà 0 fact.
# Cảnh báo đi qua kênh alert-delivery sẵn có (ALERT_WEBHOOK_URL bên dưới).
# Cooldown theo từng nguồn để job 5 phút không spam. Tối thiểu 1 giờ
# (giá trị <1 được coi là 1); đổi trực tiếp trên Admin → Radar & Catalyst.
CATALYST_STALE_ALERT_COOLDOWN_HOURS=6
# Kênh webhook chung của alert-delivery (POST JSON { rule, alert, text }).
# Để trống = tắt; RADAR_ALERT_WEBHOOK_URL ở trên là kênh riêng của radar.
ALERT_WEBHOOK_URL=
